local function CarregarBancoDeDados()
    local success, result = pcall(function()
        if readfile and isfile and isfile(FILE_PATH) then
            return HttpService:JSONDecode(readfile(FILE_PATH))
        end
    end)
    if success and type(result) == "table" then
        if result.users then Database.users = result.users end
        if result.custom_blacklist then Database.custom_blacklist = result.custom_blacklist end
    end
end

local function SalvarBancoDeDados()
    if writefile then
        pcall(function()
            writefile(FILE_PATH, HttpService:JSONEncode(Database))
        end)
    end
end

