local function ProcessarEntradaJogador(player)
    if player == LocalPlayer then return end

    local username = player.Name
    local userId = player.UserId
    local age = player.AccountAge
    local dataHoraCompleta = os.date("%d/%m/%Y %H:%M:%S")
    local totalPlayers = #Players:GetPlayers()
    local idKey = tostring(userId)

    local voceJaEstava = (tick() - LOCAL_USER_JOIN_TIME) > 2
    local ehAmigoMeu = false
    pcall(function()
        ehAmigoMeu = LocalPlayer:IsFriendsWith(userId)
    end)

    if not Database.users[idKey] then
        Database.users[idKey] = {
            userId = userId,
            username = username,
            primeiro_encontro = dataHoraCompleta,
            ultimo_encontro = dataHoraCompleta,
            total_encontros = 0,
            encontros_relevantes = 0,
            servidores_diferentes = {},
            historico_eventos = {},
            relacoes = {},
            status_atual = "SEM INDÍCIO"
        }
    end

    local userData = Database.users[idKey]
    userData.username = username
    userData.ultimo_encontro = dataHoraCompleta
    userData.total_encontros = userData.total_encontros + 1

    if not table.find(userData.servidores_diferentes, CURRENT_JOB_ID) then
        table.insert(userData.servidores_diferentes, CURRENT_JOB_ID)
    end

    local ehCoincidenciaRelevante = (totalPlayers <= 10) and voceJaEstava
    if ehCoincidenciaRelevante then
        userData.encontros_relevantes = userData.encontros_relevantes + 1
    end

    local novoEvento = {
        data_hora = dataHoraCompleta,
        servidor = CURRENT_JOB_ID,
        jogadores_no_momento = totalPlayers,
        voce_ja_estava = voceJaEstava,
        coincidencia_relevante = ehCoincidenciaRelevante
    }
    table.insert(userData.historico_eventos, novoEvento)
    if #userData.historico_eventos > MAX_HISTORY_PER_USER then
        table.remove(userData.historico_eventos, 1)
    end

    SalvarBancoDeDados()

    local isLN, targetName, targetMotivo = VerificarSeEstaNaListaNegra(userId, username)
    if isLN then
        SuspeitosUnicosServidor[userId] = true
        AtualizarContadorSuspeitos()
        userData.status_atual = "ALVO - LISTA NEGRA"
        SalvarBancoDeDados()

        MostrarToast(string.format("%s ENTROU NO SERVIDOR\nSTATUS: ALVO — LISTA NEGRA", username))
        AdicionarCardFeed("ALVO - LISTA NEGRA", username, userId, targetMotivo or "Identificado na Lista Negra", "IDENTIFICAÇÃO DIRETA NO BANCO DE DADOS")
        return
    end

    task.spawn(function()
        local vinculoStatus, alvosLista, textoAlvos = ConsultarVinculoComListaNegra(userId)

        if ehAmigoMeu and vinculoStatus == "CONFIRMADO" then
            SuspeitosUnicosServidor[userId] = true
            AtualizarContadorSuspeitos()
            userData.status_atual = "AMIGO COM RISCO ALTO"

            table.insert(userData.relacoes, {tipo = "Amigo Pessoal com Vinculo em Alvo", alvos = textoAlvos, data = dataHoraCompleta})
            SalvarBancoDeDados()

            local situacaoTexto = voceJaEstava and "está presente no servidor" or "Entrou no servidor"
            MostrarToast(string.format("%s %s ( Risco Alto ) contém %s da lista negra como amigo", username, situacaoTexto, textoAlvos))
            AdicionarCardFeed("RISCO ALTO - AMIZADE", username, userId, "Amigo de: " .. textoAlvos, "SITUAÇÃO: Amigo pessoal ligado a alvo(s) perigoso(s)")
            return
        end

        if vinculoStatus == "CONFIRMADO" then
            SuspeitosUnicosServidor[userId] = true
            AtualizarContadorSuspeitos()
            userData.status_atual = "VÍNCULO COM LISTA NEGRA"

            table.insert(userData.relacoes, {tipo = "Amigo de Alvo", alvos = textoAlvos, data = dataHoraCompleta})
            SalvarBancoDeDados()

            MostrarToast(string.format("%s ENTROU NO SERVIDOR\nSTATUS: VÍNCULO ENCONTRADO (%s)", username, textoAlvos))
            AdicionarCardFeed("VINCULO COM ALVO", username, userId, "Amigo de: " .. textoAlvos, "FONTE: CONSULTA HÍBRIDA (ENGINE + ROPROXY)")
            return
        end

        if not ehAmigoMeu and userData.encontros_relevantes >= 2 then
            SuspeitosUnicosServidor[userId] = true
            AtualizarContadorSuspeitos()
            userData.status_atual = "FATOR COINCIDÊNCIA"
            SalvarBancoDeDados()

            MostrarToast(string.format("%s ENTROU NO SERVIDOR\nSTATUS: FATOR COINCIDÊNCIA (%dX)", username, userData.encontros_relevantes))
            AdicionarCardFeed("FATOR COINCIDENCIA", username, userId, string.format("%d Encontros Relevantes", userData.encontros_relevantes), string.format("Entrou num server de %d players (Não é seu amigo)", totalPlayers))
            return
        end

        if age >= 1 and age <= 20 then
            SuspeitosUnicosServidor[userId] = true
            AtualizarContadorSuspeitos()
            userData.status_atual = "CONTA RECENTE"
            SalvarBancoDeDados()

            MostrarToast(string.format("%s ENTROU NO SERVIDOR\nSTATUS: CONTA RECENTE (%d DIAS)", username, age))
            AdicionarCardFeed("CONTA RECENTE", username, userId, string.format("Conta criada há %d dias", age), "Fator de monitoramento de ALT")
            return
        end

        if ehAmigoMeu then
            userData.status_atual = "AMIGO"
            SalvarBancoDeDados()
            return
        end

        userData.status_atual = "SEM INDÍCIO"
        SalvarBancoDeDados()
    end)
end

