local CacheIDsListaNegra = {}

local function ResolverUserId(username)
    local lowerName = string.lower(username)
    if CacheIDsListaNegra[lowerName] then
        return CacheIDsListaNegra[lowerName]
    end

    local success, result = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)

    if success and tonumber(result) then
        CacheIDsListaNegra[lowerName] = tonumber(result)
        return tonumber(result)
    end
    return nil
end

task.spawn(function()
    for nick, _ in pairs(LISTA_NEGRA_NOMES) do
        ResolverUserId(nick)
        task.wait(0.1)
    end
end)

local function VerificarSeEstaNaListaNegra(userId, username)
    if username then
        local lowerName = string.lower(username)
        if LISTA_NEGRA_NOMES[lowerName] then
            return true, username, LISTA_NEGRA_NOMES[lowerName]
        end
    end

    if userId then
        for lowerName, cachedId in pairs(CacheIDsListaNegra) do
            if cachedId == userId then
                return true, lowerName, LISTA_NEGRA_NOMES[lowerName]
            end
        end
    end

    return false, nil, nil
end

local CacheVinculos = {}

local function RequisicaoProxy(url)
    local urlProxy = string.gsub(url, "roblox%.com", "roproxy.com")
    local success, response = pcall(function()
        if request then
            return request({Url = urlProxy, Method = "GET"})
        elseif http_request then
            return http_request({Url = urlProxy, Method = "GET"})
        elseif syn and syn.request then
            return syn.request({Url = urlProxy, Method = "GET"})
        else
            return {Body = game:HttpGet(urlProxy)}
        end
    end)
    return success and response or nil
end

local function ConsultarVinculoComListaNegra(userId)
    if CacheVinculos[userId] then
        return CacheVinculos[userId].status, CacheVinculos[userId].alvos, CacheVinculos[userId].textoAlvos
    end

    for lowerNick, _ in pairs(LISTA_NEGRA_NOMES) do
        if not CacheIDsListaNegra[lowerNick] then
            ResolverUserId(lowerNick)
        end
    end

    local alvosEncontradosMap = {}
    local alvosEncontradosList = {}

    local sucessoNativo, friendPages = pcall(function()
        return Players:GetFriendsAsync(userId)
    end)

    if sucessoNativo and friendPages then
        while true do
            local paginaAtual = friendPages:GetCurrentPage()
            
            for _, amigo in ipairs(paginaAtual) do
                local fId = tonumber(amigo.Id)
                local fName = string.lower(tostring(amigo.Username or ""))

                for lowerNick, _ in pairs(LISTA_NEGRA_NOMES) do
                    local targetId = CacheIDsListaNegra[lowerNick]
                    if (targetId and fId == targetId) or (fName == lowerNick) then
                        if not alvosEncontradosMap[lowerNick] then
                            alvosEncontradosMap[lowerNick] = true
                            table.insert(alvosEncontradosList, lowerNick)
                        end
                    end
                end
            end

            if friendPages.IsFinished then
                break
            end

            local avancou = pcall(function()
                friendPages:AdvanceToNextPageAsync()
            end)

            if not avancou then
                task.wait(0.5)
            end
            task.wait(0.02)
        end
    end

    if #alvosEncontradosList == 0 then
        local cursor = ""
        local processamentoConcluido = false
        local tentativasComErro = 0

        while not processamentoConcluido and tentativasComErro < 3 do
            local url = "https://friends.roblox.com/v1/users/" .. userId .. "/friends/find?userSort=0&limit=50"
            if cursor and cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end

            local resp = RequisicaoProxy(url)

            if resp and resp.Body then
                local successDecode, data = pcall(function()
                    return HttpService:JSONDecode(resp.Body)
                end)

                if successDecode and type(data) == "table" and data.data then
                    tentativasComErro = 0
                    for _, friendInfo in ipairs(data.data) do
                        local fId = tonumber(friendInfo.id)
                        local fName = string.lower(tostring(friendInfo.name or friendInfo.username or ""))

                        for lowerNick, _ in pairs(LISTA_NEGRA_NOMES) do
                            local targetId = CacheIDsListaNegra[lowerNick]
                            if (targetId and fId == targetId) or (fName == lowerNick) then
                                if not alvosEncontradosMap[lowerNick] then
                                    alvosEncontradosMap[lowerNick] = true
                                    table.insert(alvosEncontradosList, lowerNick)
                                end
                            end
                        end
                    end

                    local nextCursor = data.nextPageCursor or data.nextCursor
                    if nextCursor and type(nextCursor) == "string" and nextCursor ~= "" then
                        cursor = nextCursor
                        task.wait(0.05)
                    else
                        processamentoConcluido = true
                    end
                else
                    tentativasComErro = tentativasComErro + 1
                    task.wait(1)
                end
            else
                tentativasComErro = tentativasComErro + 1
                task.wait(1)
            end
        end
    end

    -- COMPILAÇÃO FINAL
    if #alvosEncontradosList > 0 then
        local textoAlvos = table.concat(alvosEncontradosList, ", ")
        CacheVinculos[userId] = {status = "CONFIRMADO", alvos = alvosEncontradosList, textoAlvos = textoAlvos}
        return "CONFIRMADO", alvosEncontradosList, textoAlvos
    end

    CacheVinculos[userId] = {status = "NENHUM", alvos = {}, textoAlvos = ""}
    return "NENHUM", {}, ""
end

